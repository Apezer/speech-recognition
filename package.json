{
  "name": "vico-speech-recognition",
  "version": "0.2.0",
  "private": true,
  "description": "Vico 豆包云端语音转文字测试台",
  "author": "Vico",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5183 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-test-audio.ps1 && electron test/desktop-smoke.cjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.vico.speech.recognition",
    "productName": "Vico Speech Recognition",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
